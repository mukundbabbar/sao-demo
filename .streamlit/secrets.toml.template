# API Keys
# -----------------------------------------------------------------------------
# Ollama (local LLM — no API key required)
# ollama_base_url = "http://localhost:11434"
ollama_default_chat_model = "gemma4"
# Separate from chat models — used for RAG embeddings (run: ollama pull nomic-embed-text)
ollama_embedding_model = "nomic-embed-text"

# OpenAI (hosted LLM — required when using Hosted provider in the UI)
# openai_api_key = "..."
openai_default_chat_model = "gpt-4o"
openai_embedding_model = "text-embedding-3-large"

# AWS Bedrock (hosted LLM via AWS — required when using Bedrock provider in the UI)
# Auth uses a Bedrock API key (bearer token); no SigV4 access keys needed.
# Loaded into env as AWS_BEARER_TOKEN_BEDROCK / AWS_REGION.

# Paste your Amazon Bedrock API key
bedrock_api_key = "..."

# AWS region for Bedrock inference
aws_region = "us-east-1"

bedrock_default_chat_model = "mistral.ministral-3-14b-instruct"

# Separate from chat models — used for RAG embeddings (its own {domain}_bedrock_index)
bedrock_embedding_model = "amazon.titan-embed-text-v2:0"

# Splunk Agent Observability Configuration
# -----------------------------------------------------------------------------
# Each domain automatically gets its own Splunk AO project/agent stream:
#   Default project: "sao-demo-{domain_name}"
#   Override in domains/{domain}/config.yaml under splunk_ao:
#
# Pick ONE deployment (on-prem OR SaaS). Do not mix those credential sets.
# Env vars: https://agent-observability-docs.splunk.com/references/faqs/find-keys
# -----------------------------------------------------------------------------

# On-premises / standalone / custom (maps to SPLUNK_AO_API_KEY, SPLUNK_AO_CONSOLE_URL)
# Uncomment these and leave the SaaS block commented.
# splunk_ao_api_key = "..."
# splunk_ao_console_url = "https://console.example.com"
# Only if the API URL cannot be derived from the console URL (SPLUNK_AO_API_URL)
# splunk_ao_api_url = "https://api.example.com"

# SaaS — Splunk Observability Cloud (maps to SPLUNK_AO_REALM, SPLUNK_AO_O11Y_TOKEN)
# Realm is the host in https://app.{realm}.observability.splunkcloud.com (e.g. us1).
# Create the token in Settings > Access Tokens (INGEST; API with agent_observability_admin if used for CRUD).
splunk_ao_realm = "us1"
splunk_ao_o11y_token = "..."
# Optional dedicated CRUD token (SPLUNK_AO_O11Y_API_TOKEN). If unset, the ingest token is used for CRUD too.
# splunk_ao_o11y_api_token = "..."
# Optional OpenTelemetry service name for the FastAPI /query span (OTEL_SERVICE_NAME).
# Start the API with `python start_api.py` so zero-code `opentelemetry-instrument`
# continues caller traces in APM. SQL clients are disabled there so select/show
# does not appear inside the SAO agent session.
# otel_service_name = "sao-demo-api"
# Optional: set true to deactivate telemetry collection (SPLUNK_AO_LOGGING_DISABLED)
# splunk_ao_logging_disabled = "false"

# Agent Control (runtime guardrails)
# Enable controls in the Splunk AO UI -> Project -> Agent Stream -> Controls
# On-prem: agent_control_url = "https://console.example.com/api/agent-control"
#          agent_control_api_key_header = "Splunk-AO-API-Key"
# SaaS: leave URL unset; derived as https://app.{realm}.observability.splunkcloud.com/ao/agent-control
#       header is X-SF-Token (not Splunk-AO-API-Key)
agent_control_agent_name = "sao-demo-agent"
agent_control_runtime_auth_mode = "jwt"
# Agent Control target_type is still log_stream; target_id is the agent stream UUID.
agent_control_target_type = "log_stream"


# PostgreSQL Configuration (pgvector)
# -----------------------------------------------------------------------------
# Must match the running Postgres container (same as galileo-golden-demo compose):
# POSTGRES_USER=postgres POSTGRES_PASSWORD=mypassword POSTGRES_DB=vectordb
postgres_host = "localhost"
postgres_port = "5432"
postgres_user = "postgres"
postgres_password = "mypassword"
postgres_db = "vectordb"

# Environment Configuration
# -----------------------------------------------------------------------------
# This is no longer configurable; don't change this value
# environment = "local"
# No longer used; don't change this value.
environment = "local"

# Live Finance Data (Optional)
# -----------------------------------------------------------------------------
# Alpha Vantage API key for backup stock data source.
# Get a free key at: https://www.alphavantage.co/support/#api-key
# Note: Yahoo Finance (yfinance) is used as the primary source and requires no key.
# PS: This key is not needed for any of the current Domains.
alpha_vantage_api_key = "..."

# Admin Configuration
# -----------------------------------------------------------------------------
# Used to authorize users for deleting experiments in the UI
admin_key = ""
